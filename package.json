{
  "name": "dsh-codex-computer-use",
  "version": "0.1.0-experimental.4",
  "description": "DSH Codex Computer Use plugin with automatic, verified official runtime bootstrap; no preinstalled Codex required.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "codex",
    "computer-use",
    "mcp",
    "macos"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./skills": "./lib/skills.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./setup": "./lib/setup.js"
  },
  "bin": {
    "dsh-codex-cu-doctor": "./lib/doctor.js",
    "dsh-codex-cu-setup": "./lib/setup.js"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "skills/**/*",
    "docs/**/*",
    "install.mjs",
    "runtime-source.json",
    "component-mirrors.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-mcp-client": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-group": "^1.0.1",
    "@deepseek-ai/cordis-plugin-hmr": "^1.0.16",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-app-boot": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-loader-smoke": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12",
    "zod": "^4.4.3"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm run test",
    "doctor": "node lib/doctor.js",
    "test:pack": "node scripts/pack-smoke.mjs",
    "postinstall": "node install.mjs",
    "setup": "node lib/setup.js --install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dshapp/dsh-codex-computer-use.git"
  },
  "homepage": "https://github.com/dshapp/dsh-codex-computer-use#readme",
  "bugs": {
    "url": "https://github.com/dshapp/dsh-codex-computer-use/issues"
  }
}
